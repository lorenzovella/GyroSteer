# Lets the logged-in user read motion data from these controllers (the same access Steam's rules give).
# Install: sudo cp 70-gyrosteer.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# then reconnect the controller. Not needed if Steam's controller rules (the steam-devices package) are installed.

# Nintendo Switch Pro Controller, Joy-Con (L), Joy-Con (R): USB, then Bluetooth
KERNEL=="hidraw*", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="2009|2006|2007", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:2009*|*057E:2006*|*057E:2007*", MODE="0660", TAG+="uaccess"

# Sony DualShock 4 (both versions), DualSense, DualSense Edge: USB, then Bluetooth
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4|09cc|0ce6|0df2", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:05C4*|*054C:09CC*|*054C:0CE6*|*054C:0DF2*", MODE="0660", TAG+="uaccess"
